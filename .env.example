# =========================================================
# CDCIM 环境配置模板（复制为 .env 后按设备修改；.env 不入库）
# 端口绑定策略：
#   - Web 入口（8080）绑定 0.0.0.0，保证 Windows 侧浏览器可通过 localhost 访问
#   - 其余中间件端口一律绑定 127.0.0.1，仅在 WSL 内可达；调试时临时改为 0.0.0.0
# =========================================================

# ---------- 通用 ----------
COMPOSE_PROJECT_NAME=cdcim
TZ=Asia/Shanghai
# 每台设备的可视内存配额（GB），仅用于文档核对，不参与运行时
NODE_MEMORY_BUDGET_GB=8

# ---------- 端口 ----------
PORT_WEB=8080              # 2D 大屏 / 3D 机房视图（nginx）
PORT_GATEWAY=8000          # API 网关 / BFF
PORT_AI=8010               # AI 网关（大模型旁路）
PORT_TDENGINE_REST=6041    # TDengine REST
PORT_KAFKA=9092            # Redpanda Kafka 协议
PORT_MQTT=1883             # Mosquitto MQTT
PORT_POSTGRES=5432
PORT_REDIS=6379
PORT_QDRANT=6333

# ---------- 数据库凭据（本地原型，勿复用生产密码）----------
POSTGRES_DB=cdcim
POSTGRES_USER=cdcim
POSTGRES_PASSWORD=cdcim_local_dev
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata

# ---------- 采集模拟器 ----------
SIM_SITE_COUNT=3           # 机房数量（待与背景卡对齐）
SIM_POINT_COUNT=2000       # 测点总数
SIM_SAMPLE_INTERVAL_SEC=5  # 采样周期（秒）
SIM_FAULT_INJECTION=true   # 是否开启故障注入接口

# ---------- 大模型（旁路增强，可留空=关闭 AI 能力，系统自动降级）----------
LLM_ENABLED=true
LLM_PROVIDER=deepseek      # deepseek | qwen | zhipu | local
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=15
LLM_MAX_TOKENS=1024
LLM_DAILY_TOKEN_QUOTA=200000

# ---------- 数据安全 ----------
# true = 送模型前强制脱敏（设备编号哈希、拓扑抽象），等保三级要求
LLM_MASK_BEFORE_SEND=true

# ---------- 运行时开关 ----------
ENABLE_3D=true
LOG_LEVEL=INFO
