# ============================================================
# CDCIM 部署配置模板（复制为 deploy/.env 后按设备修改）
# 用法：cp deploy/.env.example deploy/.env
# 纪律：
#   1. .env 不入库（.gitignore 已排除）；本模板中不得出现任何真实密钥
#   2. 所有值都被 docker-compose.yml 以 ${VAR:-默认值} 引用，缺省即用默认值
#   3. 端口整体可偏移：只改 PORT_* 三五个变量，不改编排文件（C-06）
#   4. 凭据类变量一律标 CHANGE_ME：起服务前必须替换，否则启动即失败
#      （compose 对无默认值的 ${VAR} 会报 "parameter is required"）
# ============================================================

# ---------- 0. 项目标识 ----------
COMPOSE_PROJECT_NAME=cdcim

# ---------- 1. 时区与日志 ----------
# 两台设备必须同值（C-04）；库内统一 UTC，容器本地时区仅影响日志显示
TZ=Asia/Shanghai
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- 2. 凭证（无默认值，必须替换；真实值只存本机 .env） ----------

# 2.1 PostgreSQL
PG_DB=cdcim
PG_USER=cdcim
# 生成建议：openssl rand -base64 24
PG_PASSWORD=CHANGE_ME_pg_password
# 连接池上限；物理视图记 20 连接，留一倍余量给维护窗口
PG_MAX_CONNECTIONS=40
PG_POOL_SIZE=20

# 2.2 TDengine（REST 6041 与原生 6030 共用）
TDENGINE_USER=root
TDENGINE_PASSWORD=CHANGE_ME_tdengine_password

# 2.3 Redis
REDIS_PASSWORD=CHANGE_ME_redis_password

# 2.4 MQTT（客户端账号，需与 mosquitto/passwd 一致；由 make init-mqtt 生成）
MQTT_USER=cdcim
MQTT_PASSWORD=CHANGE_ME_mqtt_password
MQTT_TOPIC_TELEMETRY=telemetry/raw

# 2.5 Grafana 管理员
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password

# ---------- 3. 端口（宿主侧；除 PORT_WEB 外全部绑 127.0.0.1） ----------
# 3.1 唯一对外端口：绑 0.0.0.0，Windows 浏览器访问 http://localhost:${PORT_WEB}
PORT_WEB=8080
# 冲突预案：被占时改 18082（不改其他变量）

# 3.2 边端区
PORT_MQTT=1883
PORT_MQTT_WS=9001
PORT_COLLECTOR=8001

# 3.3 中心区
PORT_KAFKA=9092
PORT_KAFKA_ADMIN=9644
PORT_KAFKA_PROXY=8082
PORT_STREAM=8002
PORT_ALARM=8003
PORT_API=8000
PORT_AI=8004
PORT_FLINK=8081          # 仅 --profile flink 时生效

# 3.4 数据区
PORT_TDENGINE=6030
PORT_TDENGINE_REST=6041
PORT_POSTGRES=5432
PORT_REDIS=6379
PORT_QDRANT=6333
PORT_QDRANT_GRPC=6334

# 3.5 观测
PORT_PROM=9090
PORT_GRAFANA=3000
# 冲突预案：13000 / 19090，与 PORT_WEB 三档一起改
PROM_RETENTION=15d

# ---------- 4. 采集与补传参数 ----------
# 分频采集：快变 5 s / 慢变 30 s（组件映射表 §1.1）
SAMPLE_FAST_S=5
SAMPLE_SLOW_S=30
# 边端环形队列容量（字节）：150 MB，断网 ≈ 10 min 缓冲
COLLECTOR_QUEUE_MAX_BYTES=157286400
# 补传限速（条/秒）：1440 = 30 min 数据 5 min 补完（消息契约 Q-2）
REPLAY_RATE_LIMIT=1440
# 水位线容忍乱序（秒）：60
WATERMARK_LAG_S=60

# ---------- 5. 消费组与写库批量 ----------
CONSUMER_GROUP_COMPUTE=cg-compute
CONSUMER_GROUP_ALARM=cg-alarm
CONSUMER_GROUP_AI=cg-ai
# 攒批：500 条或 200 ms，先到者触发（数据架构 §3.5）
WRITE_BATCH_SIZE=500
WRITE_BATCH_INTERVAL_MS=200
# 查询结果缓存（秒）
QUERY_CACHE_TTL_S=60
# 告警抑制窗（秒）；库层 CHECK 限制在 60~3600
SUPPRESS_WINDOW_S=300
# 会话令牌有效期（秒）
JWT_TTL_S=1800

# ---------- 6. AI 旁路开关（出厂关闭） ----------
# false = 不向任何外部地址发送数据，AI 相关字段全部保持空值，系统按纯规则告警运行
# 打开前必须先完成：脱敏规则配置、MASK_SALT 设置、供应商合规确认
AI_EXTERNAL_ENABLED=false
LLM_PROVIDER=none        # none | deepseek | qwen | zhipu | local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 超时 10 s（组件映射表 §1.5）
LLM_TIMEOUT_S=10
# 熔断：连续 5 次失败，冷却 600 s
LLM_CIRCUIT_FAILS=5
LLM_CIRCUIT_COOLDOWN_S=600
LLM_MAX_CONCURRENCY=20

# ---------- 7. 脱敏盐（占位，不得写入真实值） ----------
# 用途：设备编号哈希、机房代号化的盐值（sanitizer 的 6 条规则之一）
# 生成建议：openssl rand -hex 16
# 更换盐会改变所有历史哈希，需与 knowledge_item / 归档数据同步迁移
MASK_SALT=CHANGE_ME_mask_salt_placeholder

# ---------- 8. 镜像（占位口径，可整体切换加速源） ----------
# 物理视图 §1：tag 由 P4 锁定；此处集中一处，换加速源只改域名前缀
COLLECTOR_IMAGE=cdcim/collector-gateway:0.1
MQTT_IMAGE=eclipse-mosquitto:2.0
BROKER_IMAGE=redpandadata/redpanda:v24.2.10
STREAM_IMAGE=cdcim/stream-compute:0.1
ALARM_IMAGE=cdcim/alarm-engine:0.1
TSDB_IMAGE=tdengine/tdengine:3.3.2.0
PG_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.12.4
AI_IMAGE=cdcim/ai-proxy:0.1
API_IMAGE=cdcim/api-service:0.1
NGINX_IMAGE=nginx:1.27-alpine
PROM_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.2
FLINK_IMAGE=flink:1.19.1-scala_2.12-java17

# ---------- 9. 宿主侧路径（禁止绝对路径硬编码，C-04） ----------
# 备份与归档导出目录：两台设备的路径写在这里，不进 compose、不进脚本
BACKUP_DIR=./backup
ARCHIVE_DIR=./archive
